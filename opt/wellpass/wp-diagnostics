#!/bin/bash
#
# Version 2.2
#
current_ip=$(hostname -I)
release="2.2"
#
if [[ $(/usr/bin/id -u) -ne 0 ]]; then
    echo "Not running with sufficient permissions, please use sudo."
    exit
fi
#
# Create a visual menu box
CHOICE=$(whiptail --title "WellPass Test Unit - $HOSTNAME" --ok-button "Run Choice" --cancel-button "Exit Menu" --clear --menu "\nWellPass Diagnostics V$release\nServer IP Address's: $current_ip \nChoose an option:" 20 64 8 \
"1" "Check WiFi Signal" \
"2" "Run Network Speed Test" \
"3" "Configure Network Settings" \
"4" "Start File Server" \
"5" "Restart Results Server" \
"6" "Clear Results Data" \
"7" "PI Process Monitor" \
"8" "Configure Raspberry-PI" \
"9" "Update and Upgrade Software" \
"10" "Shutdown Device" \
"11" "Reboot Device" 3>&1 1>&2 2>&3)

# Handle the user choice based on exit status and selection
if [ $? -eq 0 ]; then
case $CHOICE in
1) wavemon ;;
2) clear ; echo -e "Running speedtest now... please wait." ; speedtest -s 4392 -f csv >> /home/wpadmin/results.csv ; echo -e "\nTest completeted and available to view at http://$current_ip \nReturning to main menu in 5 seconds..." ; sleep 5 ; php -S 0.0.0.0:80 /home/wpadmin/http/index.php > /dev/null 2>&1 & ;;
3) nmtui ;;
4) python3 -m http.server 8000 --directory /home/wpadmin/ARCHIVE_DATA > /dev/null 2>&1 & ;;
5) sudo killall php ; php -S 0.0.0.0:80 /home/wpadmin/http/index.php > /dev/null 2>&1 &  ;;
6) wp-dataclean ; echo -e "\nData has been cleared and archived.\nReturning to main menu..." ; sleep 5 ;;
7) sudo btop ;;
8) sudo raspi-config ;;
9) sudo apt-get update && sudo apt-get autoremove -y && sudo apt-get dist-upgrade -y ;;
10) clear ; echo "Power Off in 10 seconds... CTRL+C to abort" ; sleep 10 ; poweroff ;;
11) clear ; echo "Rebooting in 5 seconds... CTRL+C to abort" ; sleep 5 ; reboot ;;
esac
#
# Return to menu
#
/usr/bin/wp-diagnostics
#
else
echo "Menu exited user."
fi
